# Copy .env and fill in real values.
# .env is gitignored.

# Google Earth Engine: required for step 1 (candidate screening) and step 3 (chip download)
GEE_PROJECT=your-gee-project-id

# OpenSky Network: required for Step 5 (ADS-B evaluation)
OPENSKY_USERNAME=your-opensky-username

# Postgres/PostGIS:  used by both docker-compose.yml and pipeline itself
# Pipeline builds DB connection automatically from POSTGRES_* values below so all DB connection settings are set here
# POSTGRES_DB and POSTGRES_USER have defaults in docker-compose.yml
# POSTGRES_PASSWORD does not have a default in docker-compose.yml and fails if not set here
POSTGRES_DB=parallax
POSTGRES_USER=parallax
POSTGRES_PASSWORD=parallax

# POSTGRES_PORT defaults to Postgres's standard 5432 if omitted
# Override here if 5432 is already taken 

# POSTGRES_PORT=5433

# DATABASE_URL is composed automatically from POSTGRES_* values above
# If set below, takes precedence over all set POSTGRES_* 
# Only needed when pointing the pipeline at a Postgres that is not the local docker-compose db (e.g. remote managed db)

# DATABASE_URL=postgresql+psycopg2://user:password@host:port/dbname
